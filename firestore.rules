rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Users collection
    match /users/{userId} {
      allow read: if request.auth != null && (request.auth.uid == userId || 
                     get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'Admin');
      allow write: if request.auth != null && request.auth.uid == userId;
    }
    
    // Properties collection
    match /properties/{propertyId} {
      // Allow read for all authenticated users
      allow read: if request.auth != null;
      
      // Allow create for authenticated users (will be brokers)
      allow create: if request.auth != null && 
                     request.resource.data.brokerId == request.auth.uid &&
                     request.resource.data.status == 'Pending' &&
                     request.resource.data.isApproved == false;
      
      // Allow update only for the property owner (broker)
      allow update: if request.auth != null && 
                     request.auth.uid == resource.data.brokerId &&
                     request.resource.data.brokerId == resource.data.brokerId &&
                     request.resource.data.status == 'Pending' &&
                     request.resource.data.isApproved == false;
      
      // Allow delete only for the property owner (broker)
      allow delete: if request.auth != null && 
                     request.auth.uid == resource.data.brokerId;
      
      // Admin approval/rejection operations
      allow update: if request.auth != null &&
                     get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'Admin' &&
                     (request.resource.data.status == 'Approved' || 
                      request.resource.data.status == 'Rejected') &&
                     request.resource.data.isApproved == (request.resource.data.status == 'Approved');
    }
    
    // Inquiries collection
    match /inquiries/{inquiryId} {
      allow read: if request.auth != null && 
                     (request.auth.uid == resource.data.buyerId || 
                      request.auth.uid == resource.data.brokerId ||
                      get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'Admin');
      
      allow create: if request.auth != null && 
                     request.resource.data.buyerId == request.auth.uid;
      
      allow update: if request.auth != null && 
                     (request.auth.uid == resource.data.brokerId ||
                      get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'Admin');
    }
  }
}

// Firebase Storage Rules
service firebase.storage {
  match /b/{bucket}/o {
    // Allow read access to all authenticated users
    match /{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }
  }
}
